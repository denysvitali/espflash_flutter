# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# mise (per-user overrides; the project .mise.toml IS checked in)
mise.local.toml
.mise.local.toml
.mise.local.env

# Test coverage reports
coverage/

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml
pubspec.lock
*.jks

.claude/*
!.claude/skills/
.dart_tool
/build
.flutter-plugins-dependencies

# FVM Version Cache
.fvm/

# Golden test failure diffs (generated locally, not for VCS)
test/golden/failures/

# Local-only jsonl replay fixtures (cross-repo symlinks, not for VCS).
# Explicit exceptions below are committed regression fixtures.
test/integration/jsonl_replay/fixtures/*.jsonl
!test/integration/jsonl_replay/fixtures/minimax_e2e_tasks_commands_files.stdout.jsonl
!test/integration/jsonl_replay/fixtures/minimax_happy_cli_probe.transcript.jsonl

# Generated launcher icons — rendered from assets/icon/*.svg at build time
# by scripts/generate-icons.sh (CI runs it before every APK build).
android/app/src/main/res/mipmap-*/ic_launcher*.png

# Generated by sodium_libs:update_web — fetched at build/CI time
web/sodium.js

# Generated by Sentry native symbol upload / plugin
.sentry-native/

# Release-signing material (see scripts/setup-release-keystore.sh)
*.jks.b64
release-keystore.jks
ci-keystore.jks

# Local scratch (APK inspection, icon checks)
icon-check/
